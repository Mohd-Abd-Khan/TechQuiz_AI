# ============================================================
# TechQuiz AI — Docker Compose Environment Variables
# ============================================================
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env  (Linux/Mac)  OR  copy .env.example .env  (Windows)
#
# ⚠️  NEVER commit the actual .env file to source control.
# ============================================================

# ── Auth Secrets (generate strong random strings, min 64 chars) ──
JWT_SECRET=replace_with_a_very_long_random_secret_for_access_tokens
REFRESH_TOKEN_SECRET=replace_with_a_different_very_long_random_secret_for_refresh_tokens

# ── Frontend URL (used for CORS allowlist) ──
CLIENT_URL=http://localhost

# ── Google Gemini API Keys ──
GEMINI_KEY_1=your_primary_gemini_api_key
GEMINI_KEY_2=your_secondary_gemini_api_key
GEMINI_KEY_3=your_tertiary_gemini_api_key
GEMINI_API_KEY=your_fallback_gemini_api_key

# ── Email / SMTP (for OTP verification emails) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=TechQuiz AI <noreply@techquiz.com>
